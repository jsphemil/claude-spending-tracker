# Prisma — Supabase Postgres, pooled connection (pgbouncer, port 6543) for runtime queries.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma — Supabase Postgres, direct connection (port 5432), used only for `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Auth — safe to expose to the browser (anon key is rate-limited/RLS-scoped by design).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# Guards /api/cron/materialize-recurring — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be set in Vercel's project env vars for the Vercel Cron job to authenticate.
CRON_SECRET="xxxxx"
