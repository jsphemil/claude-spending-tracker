// Prisma schema — Personal Finance Tracker
// See build plan: C:\Users\jsphe\.claude\plans\quizzical-roaming-boole.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1:1 with Supabase auth.users (matched by id, no DB-level FK — see plan risk #8).
// Row is created by a Postgres trigger on auth.users insert (see migration
// 00x_profile_trigger), not application code, so it can't be skipped by any
// signup path (password reset, magic link, etc.).
model Profile {
  id                            String   @id @db.Uuid
  displayName                   String?
  budgetModeGlobal              Boolean  @default(false)
  showFutureTransactionsGlobal  Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}
