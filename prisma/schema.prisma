// Prisma schema — Personal Finance Tracker
// See build plan: C:\Users\jsphe\.claude\plans\quizzical-roaming-boole.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1:1 with Supabase auth.users (matched by id, no DB-level FK — see plan risk #8).
// Row is created by a Postgres trigger on auth.users insert (see migration
// 00x_profile_trigger), not application code, so it can't be skipped by any
// signup path (password reset, magic link, etc.).
model Profile {
  id                            String   @id @db.Uuid
  displayName                   String?
  budgetModeGlobal              Boolean  @default(false)
  showFutureTransactionsGlobal  Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  tags           Tag[]
}

enum AccountType {
  SAVINGS
  INVESTMENT
  DEPOSIT
  WALLET
  CREDIT_CARD
}

model Account {
  id                     String      @id @default(cuid())
  userId                 String      @db.Uuid
  name                   String
  type                   AccountType
  color                  String
  icon                   String
  currency               String      @default("INR")
  openingBalance         Decimal     @db.Decimal(14, 2)
  openingBalanceDate     DateTime    @db.Date
  creditLimit            Decimal?    @db.Decimal(14, 2)
  budgetModeEnabled      Boolean? // null = inherit Profile.budgetModeGlobal
  monthlyBudget          Decimal?    @db.Decimal(14, 2)
  showFutureTransactions Boolean? // null = inherit Profile.showFutureTransactionsGlobal
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  profile Profile @relation(fields: [userId], references: [id])

  outgoing     Transaction[] @relation("AccountLeg")
  transferFrom Transaction[] @relation("TransferFrom")
  transferTo   Transaction[] @relation("TransferTo")

  recurringRules             RecurringRule[] @relation("RecurringAccountLeg")
  recurringTransferFromRules RecurringRule[] @relation("RecurringTransferFrom")
  recurringTransferToRules   RecurringRule[] @relation("RecurringTransferTo")

  @@index([userId])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id              String       @id @default(cuid())
  userId          String       @db.Uuid
  type            CategoryType
  name            String
  icon            String
  color           String
  isSystemDefault Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  profile        Profile         @relation(fields: [userId], references: [id])
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@unique([userId, type, name])
  @@index([userId, type])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// Income, Expense, and Transfer all live on one model (see build plan 1.5):
// transfers store both account legs on a single row rather than two linked
// rows, so edit/delete is atomic and the two ledger sides can never drift.
// Row-shape validity (which fields are required per `type`) is enforced in
// the Zod validation layer plus a defense-in-depth CHECK constraint added by
// hand in this migration (Prisma can't express conditional constraints).
model Transaction {
  id          String          @id @default(cuid())
  userId      String          @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2) // always positive; sign derived from type + which leg
  date        DateTime        @db.Date
  description String?

  accountId     String? // required for INCOME/EXPENSE, null for TRANSFER
  fromAccountId String? // TRANSFER only
  toAccountId   String? // TRANSFER only
  categoryId    String? // required for INCOME/EXPENSE, null for TRANSFER

  // System-generated row mirroring Account.openingBalance/openingBalanceDate
  // (see lib/actions/accounts.ts) so the opening balance flows through every
  // ledger query — transaction lists, summaries, calendars — the same way
  // any other transaction does, instead of needing to be special-cased on
  // every page that computes income/expense. Kept in sync on account
  // create/update/delete; not directly editable/deletable through the
  // normal transaction UI (see updateTransaction/deleteTransaction guards).
  isOpeningBalance Boolean @default(false)

  // Recurring series (Phase 5). occurrenceDate is the schedule anchor — the
  // slot this row fills — and never changes; `date` is the actual date shown
  // and can diverge from it after a "just this one" edit. Plain (non-
  // recurring) transactions leave all four null; Postgres treats NULLs as
  // distinct in the unique index below, so they never collide with each other.
  recurringRuleId      String?
  occurrenceDate       DateTime? @db.Date
  isRecurringGenerated Boolean   @default(false)
  isRecurringException Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [userId], references: [id])
  // Restrict (not the default SetNull for optional relations): account
  // deletion must be blocked while transactions reference it, per the
  // Phase 1 decision — a silent SetNull here would let deletion silently
  // orphan transaction history instead of blocking it.
  account       Account?       @relation("AccountLeg", fields: [accountId], references: [id], onDelete: Restrict)
  fromAccount   Account?       @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account?       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  tags          TransactionTag[]

  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId, accountId, date])
  @@index([userId, fromAccountId, date])
  @@index([userId, toAccountId, date])
  @@index([userId, date])
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum RecurringExceptionAction {
  SKIPPED
  MODIFIED
}

// A generator, not a ledger entry — every user-visible occurrence is a real
// Transaction row (isRecurringGenerated = true) tied back here, so each one
// can be individually edited/deleted through the same code paths as a plain
// transaction. See build plan 1.6 and lib/services/recurrence.ts.
model RecurringRule {
  id            String          @id @default(cuid())
  userId        String          @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  accountId     String?
  fromAccountId String?
  toAccountId   String?
  categoryId    String?
  description   String?

  intervalCount Int
  intervalUnit  RecurrenceUnit
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date // null = repeats indefinitely
  isActive      Boolean        @default(true) // false once superseded by a "this and future" edit, or manually stopped

  // Materialization progress cursor — see ensureMaterialized in recurrence.ts.
  // Re-derivable from MAX(occurrenceDate) if this ever drifts, but storing it
  // avoids rescanning the full history on every page load.
  lastGeneratedDate DateTime? @db.Date

  supersedesRuleId String?         @unique
  supersedes       RecurringRule?  @relation("RuleSupersession", fields: [supersedesRuleId], references: [id])
  supersededBy     RecurringRule?  @relation("RuleSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     Profile   @relation(fields: [userId], references: [id])
  account     Account?  @relation("RecurringAccountLeg", fields: [accountId], references: [id], onDelete: Restrict)
  fromAccount Account?  @relation("RecurringTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account?  @relation("RecurringTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  exceptions   RecurringException[]
  tags         RecurringRuleTag[]

  @@index([userId, isActive])
}

model RecurringException {
  id              String                   @id @default(cuid())
  recurringRuleId String
  occurrenceDate  DateTime                 @db.Date
  action          RecurringExceptionAction
  transactionId   String? // set when action = MODIFIED

  rule RecurringRule @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)

  @@unique([recurringRuleId, occurrenceDate])
}

// Free-form, reusable, and orthogonal to Category (spec 5.3a): a category
// describes what kind of spending something is, a tag describes the
// occasion it belongs to (a trip, an event) — a transaction keeps its normal
// account and category, the tag is additional context spanning both.
model Tag {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  name            String
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())

  profile        Profile            @relation(fields: [userId], references: [id])
  transactions   TransactionTag[]
  recurringRules RecurringRuleTag[]

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

// Lets a tag live on a recurring series so every materialized occurrence
// inherits it automatically at generation time (see materializeRule in
// lib/services/recurrence.ts), rather than needing to be re-added by hand
// on each occurrence.
model RecurringRuleTag {
  recurringRuleId String
  tagId           String

  recurringRule RecurringRule @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recurringRuleId, tagId])
}
